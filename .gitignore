# IntelliJ / Android Studio
*.iml
.idea/

# Built by tool/android/build.sh and staged into the APK by tool/android/stage.sh.
# Twelve megabytes an ABI of compiled git is not something to review in a diff.
/tool/android/build/
/tool/android/dist/
/android/app/src/main/jniLibs/

# Fetched by tool/android/setup.sh. Most of a gigabyte, and Qualcomm's to
# distribute rather than ours.
/tool/android/toolchains/

# Generated by tool/prepare.sh (freezed, json_serializable). Unanchored, unlike
# everything above: build_runner writes them beside whatever it was annotated on.
*.g.dart
*.freezed.dart

# Generated by tool/gen_bundled_skills.dart (embedded skill/agent data).
/lib/data/prompts/bundled_skill_data.dart

# Generated by tool/gen_prompts.dart (embedded built-in project prompts).
/lib/domain/bundled_project_prompts.dart

# Generated by tool/gen_privacy_policy.dart (embedded privacy policy text).
/lib/data/privacy_policy_data.dart

# Generated by tool/prepare.sh from pubspec's `version:`. A fresh checkout has
# none until it runs prepare, same as the freezed sources above.
/assets/version.json
