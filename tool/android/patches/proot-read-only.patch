diff --git a/src/extension/read_only/read_only.c b/src/extension/read_only/read_only.c
new file mode 100644
index 0000000..252b452
--- /dev/null
+++ b/src/extension/read_only/read_only.c
@@ -0,0 +1,154 @@
+/*
+ * Entoli: directories the guest may read and must not change.
+ *
+ * The app keeps them read-only on disk (no write bits, files and
+ * directories alike), so the kernel already refuses a write there.
+ * Two things in proot would get past that: fake_id0 grants the owner
+ * read/write on every path a faked root touches, and the owner may
+ * chmod its own files whatever their mode.  The first is skipped for
+ * these paths (read_only_path(), called from fake_id0), the second is
+ * refused here with EROFS.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "extension/extension.h"
+#include "extension/read_only/read_only.h"
+#include "tracee/mem.h"
+#include "tracee/reg.h"
+#include "syscall/sysnum.h"
+#include "path/path.h"
+
+static char **paths = NULL;
+static size_t count = 0;
+
+/* The canonical host path, since that is what a translated path is: a
+ * binding's host side is canonicalized the same way.  */
+int add_read_only_path(const char *path)
+{
+	char resolved[PATH_MAX];
+	char **grown;
+
+	if (realpath(path, resolved) == NULL)
+		strncpy(resolved, path, PATH_MAX - 1), resolved[PATH_MAX - 1] = '\0';
+
+	grown = realloc(paths, (count + 1) * sizeof(char *));
+	if (grown == NULL)
+		return -ENOMEM;
+	paths = grown;
+	paths[count] = strdup(resolved);
+	if (paths[count] == NULL)
+		return -ENOMEM;
+	count++;
+	return 0;
+}
+
+bool read_only_path(const char *host_path)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		size_t length = strlen(paths[i]);
+		if (strncmp(host_path, paths[i], length) == 0
+		    && (host_path[length] == '\0' || host_path[length] == '/'))
+			return true;
+	}
+	return false;
+}
+
+/* The host path @fd names in the tracee, AT_FDCWD for its cwd.  */
+static int fd_path(const Tracee *tracee, int fd, char path[PATH_MAX])
+{
+	char link[64];
+	ssize_t length;
+
+	if (fd == AT_FDCWD)
+		snprintf(link, sizeof(link), "/proc/%d/cwd", tracee->pid);
+	else
+		snprintf(link, sizeof(link), "/proc/%d/fd/%d", tracee->pid, fd);
+	length = readlink(link, path, PATH_MAX - 1);
+	if (length < 0)
+		return -errno;
+	path[length] = '\0';
+	return 0;
+}
+
+/* The host path the (@dirfd, @path_reg) pair of a syscall names, read
+ * after proot translated it.  */
+static int at_path(const Tracee *tracee, int dirfd, Reg path_reg, char path[PATH_MAX])
+{
+	char relative[PATH_MAX];
+	int status;
+
+	status = read_string(tracee, relative, peek_reg(tracee, CURRENT, path_reg), PATH_MAX);
+	if (status < 0)
+		return status;
+	if (relative[0] == '/') {
+		strcpy(path, relative);
+		return 0;
+	}
+	status = fd_path(tracee, dirfd, path);
+	if (status < 0)
+		return status;
+	if (strlen(path) + 1 + strlen(relative) >= PATH_MAX)
+		return -ENAMETOOLONG;
+	strcat(path, "/");
+	strcat(path, relative);
+	return 0;
+}
+
+static int handle_enter_end(Tracee *tracee)
+{
+	char path[PATH_MAX];
+	int status;
+
+	switch (get_sysnum(tracee, ORIGINAL)) {
+	case PR_chmod:
+		status = at_path(tracee, AT_FDCWD, SYSARG_1, path);
+		break;
+	case PR_fchmodat:
+		status = at_path(tracee, (int) peek_reg(tracee, CURRENT, SYSARG_1), SYSARG_2, path);
+		break;
+	case PR_fchmod:
+		status = fd_path(tracee, (int) peek_reg(tracee, CURRENT, SYSARG_1), path);
+		break;
+	default:
+		return 0;
+	}
+	if (status < 0)
+		return 0;
+	return read_only_path(path) ? -EROFS : 0;
+}
+
+int read_only_callback(Extension *extension, ExtensionEvent event,
+		intptr_t data1 UNUSED, intptr_t data2 UNUSED)
+{
+	switch (event) {
+	case INITIALIZATION: {
+		static FilteredSysnum filtered_sysnums[] = {
+			{ PR_chmod,	0 },
+			{ PR_fchmod,	0 },
+			{ PR_fchmodat,	0 },
+			FILTERED_SYSNUM_END,
+		};
+		extension->filtered_sysnums = filtered_sysnums;
+		return 0;
+	}
+
+	case INHERIT_PARENT:
+		return 1;
+
+	case SYSCALL_ENTER_END:
+		return handle_enter_end(TRACEE(extension));
+
+	default:
+		return 0;
+	}
+}
