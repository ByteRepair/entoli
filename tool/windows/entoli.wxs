<!--
  The installer a release attaches: `entoli-installer.msi`. `flutter build
  windows` in Release produces a bundle that moves together — the exe resolves
  flutter_windows.dll and the plugin DLLs beside itself and the Dart assets in
  data\ beside those — so the whole Release directory is harvested, and a
  `Files` harvest is what keeps adding one file to a directory from hand.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Entoli"
      Scope="perMachine"
      Manufacturer="ByteRepair"
      Version="$(Version)"
      UpgradeCode="{EC8EF9A4-C91A-49D1-97F3-C45FFF776D7A}">

    <!-- The UpgradeCode is the identity of every install to come: an installer
         built later finds this one and replaces it, and an installer built
         sooner refuses over it. Like the Android keystore, a change here is
         not an update but a different app; it is never re-generated. -->
    <!-- Same version too: otherwise a rebuild of one version installs as a
         second entry beside the first. ICE61 warns about it, deliberately. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Entoli is already installed." />

    <!-- The icon Add/Remove Programs shows: the exe's own ico. -->
    <Icon Id="AppIcon.ico"
        SourceFile="$(sys.SOURCEFILEDIR)..\..\windows\runner\resources\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- The cabinet rides inside the MSI: an external one is a second file a
         release does not attach, and an installer that installs only where
         the cab lies beside it is a 45 KB shell elsewhere. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- The welcome screen and its Install button, with the AGPL the app
         ships under and the finish page after: WixUI_Minimal's one dialog,
         authored by the extension's own element — a bare UIRef of the set
         reads "inaccessible due to its protection level". The license text
         is the repo's own LICENSE, turned into rtf each packaging and bound
         from the script, the way the docs' own page shows it. -->
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Entoli">
        <!-- BundlePath: make-msi.ps1 passes it as the bundle's absolute path,
           the fully-qualified pattern the docs recommend. A relative pattern
           over a bind path resolved to nothing once — WIX8600 grades a
           zero-file harvest a warning, and the build shipped green. -->
      <Files Include="$(BundlePath)\**" />
      </Directory>
    </StandardDirectory>

    <!-- A shortcut is its own component, with a registry value as its key
         path: the component that does not install a file has to key on
         something, and the key path is what makes it per-machine. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component
          Id="StartMenuShortcut"
          Guid="{429392F1-A917-418E-AADF-92BC9CA70DD8}">
        <Shortcut
            Id="EntoliShortcut"
            Name="Entoli"
            Target="[INSTALLFOLDER]entoli.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKLM"
            Key="Software\ByteRepair\Entoli"
            Name="InstallFolder"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- entoli:// links open Entoli, which app_links reads from the command
         line (or hands to the running window). -->
    <Component
        Id="UrlScheme"
        Directory="INSTALLFOLDER"
        Guid="{6B0E2C1A-4F5D-4C8E-9B3A-2D7E1F8A5C40}">
      <RegistryKey Root="HKLM" Key="Software\Classes\entoli">
        <RegistryValue Type="string" Value="URL:Entoli" KeyPath="yes" />
        <RegistryValue Name="URL Protocol" Type="string" Value="" />
        <RegistryValue
            Key="DefaultIcon"
            Type="string"
            Value="&quot;[INSTALLFOLDER]entoli.exe&quot;,0" />
        <RegistryValue
            Key="shell\open\command"
            Type="string"
            Value="&quot;[INSTALLFOLDER]entoli.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </Component>
  </Package>
</Wix>