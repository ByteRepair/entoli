<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for LLM HTTP calls and the in-app webview, which the debug
         and profile overlays below also declare. Listing it here means a
         release build can reach the network too. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Which resolver the network uses, and nothing else about it. A Linux
         installed from the Terminal settings reads /etc/resolv.conf, a file
         Android does not keep, so without asking this the guest would have to
         be handed a public resolver chosen on the user's behalf. Normal
         permission: granted at install, with nothing to prompt for. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- The foreground services': they keep the process alive while a turn
         runs, while voice mode is listening, and while a model is downloading.
         See "Staying alive off screen" in CLAUDE.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Voice mode. From Android 14 a service that holds the microphone has to
         say which type it is *and* hold RECORD_AUDIO before it may start. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>

    <!-- Reminders. Exact alarms need the user's grant from Android 12 on
         (denied by default from 13); where it is not held the alarm falls back
         to inexact, which can fire minutes late under Doze — the Reminders
         settings page says so and links to the grant. Boot re-arms every armed
         reminder, since Android forgets its alarms when it shuts down; the
         time-set action covers the user moving the clock underneath them. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Sync: scan a pairing QR from the paste-code field on Android. Linux has
         no camera, so the button is Android-only. Not required: a device with
         no camera still pairs by typing the code. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- The Android-system voice engines, which the sentinel picks resolve to.
         From Android 11 an app sees only the packages it declares an interest
         in, and the queries for a recognition service and for a TTS engine are
         both answered out of that view: without this they report nothing on
         every modern phone rather than only on the ones that genuinely have
         neither. And a recognition service Entoli cannot see is one it cannot
         name, which is what `startRecognition` has to do. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_cookie"
        android:usesCleartextTraffic="true">
        <!-- The LAN signaling server (`lan_signaler.dart`) is plain HTTP on a
             direct IP. Android 9+ blocks cleartext by default, which hung
             pairing at the signaling step: the joiner's POST never reached the
             host, and both waited out their timeouts. It is safe because the
             server only ever sees the WebRTC SDP blobs (opaque without the
             keys) and a one-time code; the pairing secret travels out-of-band,
             DTLS encrypts the data channel, and framing.dart adds app-layer
             ChaCha20-Poly1305 AEAD with keys from the handshake. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- MainActivity is the launch entry, so the Flutter tool's pre-build
                 manifest parse (which matches `activity` by exact name and never
                 sees `activity-alias`) finds it. It wears the app-level icon
                 (@mipmap/ic_cookie); the PromptIcon alias below is enabled by
                 MainActivity.kt when the user picks the other icon, and
                 MainActivity is disabled in its place so the app does not show
                 twice. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Entoli as a share target: another app's files, offered a
                 workspace by ShareTargetPage. On the alias below as well, since
                 whichever of the two is enabled is the only component that can
                 be started, and a share must not stop working because the user
                 changed the icon. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <!-- Entoli as the system's assistant: the gesture that used to
                 raise Google's launches Entoli on a new chat, in the project
                 and the view the Assistant settings name. CATEGORY_DEFAULT is
                 load-bearing rather than boilerplate — the role is offered to
                 whatever `queryIntentActivities(ACTION_ASSIST,
                 MATCH_DEFAULT_ONLY)` finds exported, so without it the app is
                 not in the picker at all. On the alias below as well, for the
                 reason the share filter is. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- The non-default icon, enabled by MainActivity.kt when the user picks
             it. Disabled by default: MainActivity is the launcher entry, and only
             one of {MainActivity, this alias} is enabled at a time, or the app
             appears on the home screen twice. -->
        <activity-alias
            android:name=".PromptIcon"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_prompt"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity-alias>
        <!-- dataSync rather than one of the named types: what a turn is doing
             is a model call and whatever the user's own commands do, which is
             none of location, media or the rest. A download is the same kind of
             work; voice mode is not, and has to say microphone. -->
        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <service
            android:name=".PrefillService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <!-- Reminders. Both are system-only entry points and hold no state of
             their own: the alarm receiver hands the id to Dart and holds the
             process, the boot receiver re-arms what reminders.json lists. Not
             exported — the system delivers its own protected broadcasts to
             them regardless, and no other app may wake either. -->
        <receiver android:name=".ReminderReceiver" android:exported="false"/>
        <receiver android:name=".ReminderBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- What lets another app read a workspace file Entoli hands it. The
             paths it will mint a URI for are one cache directory: everything
             shared or opened is copied there first, so the data directory is
             never exposed. See FilesChannel.kt and res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- The workspaces in the Files app and in every file picker. Exported
             behind MANAGE_DOCUMENTS, which only the system's document UI holds.
             See WorkspaceProvider.kt. -->
        <provider
            android:name=".WorkspaceProvider"
            android:authorities="${applicationId}.workspaces"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
            </intent-filter>
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
