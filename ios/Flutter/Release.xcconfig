// The iSH entry points are found by name at runtime: Ish.xcconfig keeps them
// through the dead-strip, and an archive strips the local symbols only, the
// default, all, taking the global names as well. A debug build is never
// stripped.
STRIP_STYLE = non-global
#include "Ish.xcconfig"
#include "Signing.xcconfig"
#include "Generated.xcconfig"
